// Settings (decision 0008): changes apply at once and are saved, unless Vigie was started with
// --no-settings.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { VButton, VSegment, VSwitch } from "controls.slint";

component Section inherits Rectangle {
    in property <string> title;
    background: Theme.surface;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-section;
            font-weight: Theme.weight-strong;
        }
        @children
    }
}

// A labelled line: the label on the left, the control on the right.
component Line inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: Theme.space-3;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.text-muted;
            font-size: Theme.font-caption;
            wrap: word-wrap;
        }
    }
    @children
}

component SwitchLine inherits Line {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    VSwitch {
        y: (parent.height - self.height) / 2;
        label: root.label;
        checked <=> root.checked;
        enabled: root.enabled;
        toggled(on) => { root.toggled(on); }
    }
}

export component SettingsView inherits Rectangle {
    // Indices into the choices of vigie_core::settings.
    in-out property <int> interval;
    in-out property <int> theme;
    in-out property <int> language;
    in-out property <bool> publisher;
    in-out property <bool> pid;
    in-out property <bool> cpu;
    in-out property <bool> memory;
    in-out property <bool> alerts;
    in-out property <int> cpu-alert;
    in-out property <int> cpu-minutes;
    in-out property <int> memory-alert;
    in-out property <bool> close-to-tray;
    in-out property <bool> check-updates;
    in property <int> update-state;
    in property <string> update-version;
    in property <int> update-error-kind;
    in property <string> update-error;
    in property <int> update-mode;
    in property <string> app-version;
    callback update-clicked();
    callback update-check();
    in property <bool> tray-available;
    // Where the settings are saved; empty with --no-settings.
    in property <string> path;
    callback edited();
    in property <int> taskmgr-state;
    in property <string> taskmgr-path;
    in property <bool> taskmgr-installed;
    callback taskmgr-toggled(bool);
    callback taskmgr-repair();

    VerticalLayout {
        HorizontalLayout {
            padding: Theme.space-3;
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;
            Text {
                text: @tr("Settings");
                color: Theme.text;
                font-size: Theme.font-section;
                font-weight: Theme.weight-strong;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-4;
                alignment: start;

                if root.update-mode != 3: Section {
                    title: @tr("Updates");
                    SwitchLine {
                        label: @tr("Check for updates");
                        hint: @tr("At launch and every 6 hours, Vigie asks GitHub which version is the newest. Nothing else is sent.");
                        checked <=> root.check-updates;
                        toggled => { root.edited(); }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-3;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.update-state == 1 ? @tr("Checking for updates…")
                                    : root.update-state == 2 ? @tr("Vigie {} is up to date.", root.app-version)
                                    : root.update-state == 3 ? @tr("Vigie {} is available. You have {}.", root.update-version, root.app-version)
                                    : root.update-state == 4 ? @tr("Downloading Vigie {}…", root.update-version)
                                    : root.update-state == 5 ? @tr("The update did not go through.")
                                    : root.update-state == 6 ? @tr("Installing Vigie {}: Vigie will close and open again.", root.update-version)
                                    : @tr("Vigie {}", root.app-version);
                                color: root.update-state == 5 ? Theme.danger : Theme.text;
                                font-size: Theme.font-body;
                                wrap: word-wrap;
                            }
                            if root.update-state == 5: Text {
                                text: (root.update-error-kind == 1 ? @tr("Could not reach GitHub. Check the connection and try again.")
                                    : root.update-error-kind == 2 ? @tr("This release publishes no checksum for its installer, so Vigie will not run it. Download it from the release page instead.")
                                    : root.update-error-kind == 3 ? @tr("The download does not match its checksum: it was deleted, not run.")
                                    : root.update-error-kind == 4 ? @tr("The download failed.")
                                    : root.update-error-kind == 5 ? @tr("The installer did not start.")
                                    : root.update-error-kind == 6 ? @tr("Test run: the installer was checked but not started.")
                                    : "") + (root.update-error == "" ? "" : " (" + root.update-error + ")");
                                color: Theme.text-muted;
                                font-size: Theme.font-caption;
                                wrap: word-wrap;
                            }
                            if root.update-state == 3 && root.update-mode == 1: Text {
                                text: @tr("This copy of Vigie is not the installed one: download the new version from its release page.");
                                color: Theme.text-muted;
                                font-size: Theme.font-caption;
                                wrap: word-wrap;
                            }
                            if root.update-state == 3 && root.update-mode == 2: Text {
                                text: @tr("This Vigie runs as administrator (opened with Ctrl+Shift+Esc). Open Vigie normally to update it.");
                                color: Theme.text-muted;
                                font-size: Theme.font-caption;
                                wrap: word-wrap;
                            }
                        }
                        if root.update-state == 3 && root.update-mode != 2: VButton {
                            text: root.update-mode == 1 ? @tr("Open the release page") : @tr("Update");
                            kind: 1;
                            clicked => { root.update-clicked(); }
                        }
                        if root.update-state == 0 || root.update-state == 2 || root.update-state == 5: VButton {
                            text: @tr("Check now");
                            clicked => { root.update-check(); }
                        }
                    }
                }

                Section {
                    title: @tr("General");
                    Line {
                        label: @tr("Refresh every");
                        hint: @tr("Vigie slows down on its own in the background and when minimised.");
                        VSegment {
                            labels: [@tr("0.5 s"), "1 s", "2 s", "5 s"];
                            current <=> root.interval;
                            changed => { root.edited(); }
                        }
                    }
                    Line {
                        label: @tr("Theme");
                        VSegment {
                            labels: [@tr("System"), @tr("Dark"), @tr("Light")];
                            current <=> root.theme;
                            changed => { root.edited(); }
                        }
                    }
                    Line {
                        label: @tr("Language");
                        VSegment {
                            labels: [@tr("System"), "English", "Français"];
                            current <=> root.language;
                            changed => { root.edited(); }
                        }
                    }
                }

                Section {
                    title: @tr("Process table columns");
                    SwitchLine { label: @tr("Publisher"); checked <=> root.publisher; toggled => { root.edited(); } }
                    SwitchLine { label: @tr("PID"); checked <=> root.pid; toggled => { root.edited(); } }
                    SwitchLine { label: @tr("CPU"); checked <=> root.cpu; toggled => { root.edited(); } }
                    SwitchLine { label: @tr("Memory"); checked <=> root.memory; toggled => { root.edited(); } }
                }

                Section {
                    title: @tr("Alerts");
                    SwitchLine {
                        label: @tr("Notify me when something slows the computer down");
                        hint: @tr("A system notification when the processor is saturated, memory runs low, or a threshold below is crossed. At most one per resource every 15 minutes.");
                        checked <=> root.alerts;
                        enabled: root.tray-available;
                        toggled => { root.edited(); }
                    }
                    Line {
                        label: @tr("Processor above");
                        VSegment {
                            labels: [@tr("Off"), "80 %", "90 %", "95 %"];
                            current <=> root.cpu-alert;
                            changed => { root.edited(); }
                        }
                    }
                    Line {
                        label: @tr("For at least");
                        VSegment {
                            labels: [@tr("1 min"), @tr("2 min"), @tr("5 min")];
                            current <=> root.cpu-minutes;
                            changed => { root.edited(); }
                        }
                    }
                    Line {
                        label: @tr("Memory in use above");
                        VSegment {
                            labels: [@tr("Off"), "85 %", "90 %", "95 %"];
                            current <=> root.memory-alert;
                            changed => { root.edited(); }
                        }
                    }
                }

                Section {
                    title: @tr("Window");
                    SwitchLine {
                        label: @tr("Closing the window keeps Vigie in the notification area");
                        hint: root.tray-available ? @tr("Open it again from its icon; quit from the icon's menu.") : @tr("Not available: there is no notification area icon.");
                        checked <=> root.close-to-tray;
                        enabled: root.tray-available;
                        toggled => { root.edited(); }
                    }
                }

                if root.taskmgr-state != 4: Section {
                    title: @tr("Task Manager");
                    SwitchLine {
                        label: @tr("Open Vigie with Ctrl+Shift+Esc");
                        hint: root.taskmgr-state == 3 ? @tr("Another program opens instead of Task Manager: {}", root.taskmgr-path)
                            : !root.taskmgr-installed && root.taskmgr-state != 1 ? @tr("Available once Vigie is installed.")
                            : @tr("Replaces Task Manager for every account on this computer. Asks for administrator rights; turn it off here at any time. Uninstalling Vigie turns it off.");
                        checked: root.taskmgr-state == 1;
                        enabled: root.taskmgr-state == 1 || (root.taskmgr-state == 0 && root.taskmgr-installed);
                        toggled(on) => { root.taskmgr-toggled(on); }
                    }
                    if root.taskmgr-state == 2: HorizontalLayout {
                        spacing: Theme.space-3;
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Ctrl+Shift+Esc points to a Vigie that no longer exists ({}): Task Manager cannot open. Repair it to give Ctrl+Shift+Esc back to Task Manager.", root.taskmgr-path);
                            color: Theme.danger;
                            font-size: Theme.font-body;
                            wrap: word-wrap;
                        }
                        VButton {
                            text: @tr("Repair");
                            kind: 2;
                            clicked => { root.taskmgr-repair(); }
                        }
                    }
                }

                Text {
                    text: root.path == "" ? @tr("Settings are not saved in this session (--no-settings).") : @tr("Saved in {}", root.path);
                    color: Theme.text-muted;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }
        }
    }
}
