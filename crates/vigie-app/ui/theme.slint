// Design tokens from docs/BRAND.md. Views use these instead of literal colours and sizes.
// The native style (fluent, cupertino, cosmic) still draws the widgets; the tokens colour
// Vigie's own surfaces and follow Palette.color-scheme, so --dark and --light switch both.

import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Brand
    out property <color> lagoon: #2EC4B6;
    out property <color> ink: #0E1116;

    // Surfaces and text
    out property <color> background: dark ? #0E1116 : #F6F7F4;
    out property <color> surface: dark ? #151A21 : #FFFFFF;
    out property <color> raised: dark ? #1B212A : #FFFFFF;
    out property <color> border: dark ? #252C37 : #E3E6E1;
    out property <color> text: dark ? #E6EAF0 : #0E1116;
    out property <color> text-muted: dark ? #8B93A1 : #5B6472;
    out property <color> accent: dark ? #2EC4B6 : #0B7A71;
    out property <color> selection: #2EC4B6.with-alpha(dark ? 0.16 : 0.18);

    // Heat: background tints for hot cells, three steps
    out property <color> heat-1: #FFB020.with-alpha(dark ? 0.14 : 0.16);
    out property <color> heat-2: #FFB020.with-alpha(dark ? 0.30 : 0.34);
    out property <color> heat-3: dark ? #FF5D5D.with-alpha(0.34) : #D92D3A.with-alpha(0.22);
    out property <color> danger: dark ? #FF5D5D : #D92D3A;
    out property <color> warning: dark ? #FFB020 : #B45309;

    // Type scale
    out property <length> font-caption: 12px;
    out property <length> font-body: 13px;
    out property <length> font-section: 15px;
    out property <length> font-title: 20px;
    out property <length> font-figure: 28px;
    out property <int> weight-regular: 400;
    out property <int> weight-strong: 600;

    // Spacing (4-point grid), radii, density
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
    out property <length> radius-small: 4px;
    out property <length> radius-control: 8px;
    out property <length> radius-panel: 12px;
    out property <length> row-height: 28px;
    out property <length> bar-height: 30px;
}
