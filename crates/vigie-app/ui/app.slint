import { AboutSlint, Button, LineEdit, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DiskCard, PerfView, PerformanceView } from "performance.slint";

export { DiskCard, PerfView }

export struct ProcRow {
    // Identity for model patching (see src/model.rs).
    key: int,
    // 0: section header, 1: process, 2: a process's own line under its expanded subtree.
    kind: int,
    // Section of a header: 0 apps, 1 background, 2 system, 3 all.
    group: int,
    depth: int,
    // Header: processes in the section. Process: its descendants.
    count: int,
    expandable: bool,
    expanded: bool,
    // Index in AppWindow.icons, or -1 when the executable gives none (or cannot be read).
    icon: int,
    name: string,
    pid: int,
    // Start time (low 31 bits): with the PID, names this process for actions.
    start: int,
    publisher: string,
    // Processes "end process tree" ends besides this one (real descendants).
    tree-size: int,
    // Vigie itself: it must not suspend itself.
    own: bool,
    cpu: string,
    memory: string,
    cpu-heat: int,
    memory-heat: int,
}

// Optional columns; Name is always shown.
export struct ColumnSet {
    publisher: bool,
    pid: bool,
    cpu: bool,
    memory: bool,
}

component Cell inherits Text {
    vertical-alignment: center;
    overflow: elide;
    color: Theme.text;
    font-size: Theme.font-body;
}

// A right-aligned figure whose background warms with its heat level (0 to 3).
component HeatCell inherits Rectangle {
    in property <string> text;
    in property <int> heat;
    // The tint spills into half of the column gutters, so figures do not touch its edge.
    Rectangle {
        x: -6px;
        width: parent.width + 12px;
        background: root.heat >= 3 ? Theme.heat-3 : root.heat == 2 ? Theme.heat-2 : root.heat == 1 ? Theme.heat-1 : transparent;
    }
    Cell {
        width: 100%;
        height: 100%;
        text: root.text;
        horizontal-alignment: right;
    }
}

component HeaderCell inherits Cell {
    color: Theme.text-muted;
    font-size: Theme.font-caption;
    font-weight: Theme.weight-strong;
}

component Columns inherits HorizontalLayout {
    padding-left: Theme.space-4;
    padding-right: Theme.space-4;
    spacing: Theme.space-3;
}

// A clickable column header. The active column shows its direction.
component SortHeader inherits Rectangle {
    in property <string> label;
    in property <int> column;
    in property <int> sort-column;
    in property <bool> sort-ascending;
    in property <TextHorizontalAlignment> alignment: left;
    callback clicked(int);
    property <bool> active: column == sort-column;

    HeaderCell {
        width: 100%;
        height: 100%;
        horizontal-alignment: root.alignment;
        text: root.active ? (root.sort-ascending ? root.label + " ↑" : root.label + " ↓") : root.label;
        color: root.active || touch.has-hover ? Theme.text : Theme.text-muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.column); }
    }
}

// A right- or down-pointing chevron, drawn so it does not depend on a font having the glyph.
component Chevron inherits Path {
    in property <bool> open;
    width: 14px;
    height: 14px;
    viewbox-width: 14;
    viewbox-height: 14;
    stroke: Theme.text-muted;
    stroke-width: 1.6px;
    commands: open ? "M 3.5 5.5 L 7 9 L 10.5 5.5" : "M 5.5 3.5 L 9 7 L 5.5 10.5";
}
// A section of the table: apps, background processes, services and system.
component GroupHeader inherits Rectangle {
    in property <int> group;
    in property <int> count;
    in property <bool> open: true;
    callback toggle();
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
    Columns {
        padding-top: Theme.space-2;
        spacing: Theme.space-1;
        Chevron {
            open: root.open;
            y: (parent.height - self.height) / 2 + Theme.space-1;
        }
        Cell {
            horizontal-stretch: 1;
            text: root.group == 0 ? @tr("Apps ({})", root.count)
                : root.group == 1 ? @tr("Background processes ({})", root.count)
                : root.group == 2 ? @tr("Services and system ({})", root.count)
                : @tr("Processes ({})", root.count);
            color: Theme.text-muted;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-strong;
        }
    }
}

// One process line: indented by its depth, with a chevron when it has children.
component ProcessLine inherits Rectangle {
    in property <ProcRow> item;
    in property <image> icon;
    in property <ColumnSet> columns;
    callback toggle(int);
    Columns {
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.space-1;
            Rectangle { width: root.item.depth * 16px; }
            Rectangle {
                width: 16px;
                if root.item.expandable: Chevron {
                    open: root.item.expanded;
                    y: (parent.height - self.height) / 2;
                }
                TouchArea {
                    enabled: root.item.expandable;
                    mouse-cursor: root.item.expandable ? pointer : default;
                    clicked => { root.toggle(root.item.pid); }
                }
            }
            Rectangle {
                width: 16px;
                if root.item.icon >= 0: Image {
                    source: root.icon;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    image-rendering: smooth;
                }
                // Generic process: an empty rounded square.
                if root.item.icon < 0: Rectangle {
                    width: 12px;
                    height: 12px;
                    x: 2px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Theme.text-muted.with-alpha(0.6);
                }
            }
            Rectangle { width: Theme.space-1; }
            Cell {
                text: root.item.name;
                horizontal-stretch: 0;
            }
            Cell {
                // The number of processes under a collapsed or expanded parent, itself included.
                text: root.item.expandable ? "(" + (root.item.count + 1) + ")" : "";
                color: Theme.text-muted;
                horizontal-stretch: 1;
            }
        }
        if root.columns.publisher: Cell { text: root.item.publisher; width: 160px; color: Theme.text-muted; }
        if root.columns.pid: Cell { text: root.item.pid; width: 72px; horizontal-alignment: right; color: Theme.text-muted; }
        if root.columns.cpu: HeatCell { text: root.item.cpu; heat: root.item.cpu-heat; width: 72px; }
        if root.columns.memory: HeatCell { text: root.item.memory; heat: root.item.memory-heat; width: 96px; }
    }
}

// One entry of the navigation rail: a line icon, highlighted when its view is shown.
component RailItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: Theme.radius-control;
    background: root.active ? Theme.selection : touch.has-hover ? Theme.text.with-alpha(0.05) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    Path {
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.active ? Theme.accent : Theme.text-muted;
        stroke-width: 1.6px;
        fill: transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Navigation between the views: Processes and Performance.
component Rail inherits Rectangle {
    in property <int> tab;
    callback selected(int);
    width: 52px;
    background: Theme.surface;
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        padding-top: Theme.space-3;
        spacing: Theme.space-2;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            RailItem {
                label: @tr("Processes");
                icon: "M 4 6 L 20 6 M 4 12 L 20 12 M 4 18 L 14 18";
                active: root.tab == 0;
                clicked => { root.selected(0); }
            }
        }
        HorizontalLayout {
            alignment: center;
            RailItem {
                label: @tr("Performance");
                icon: "M 3 17 L 8 11 L 12 14 L 18 6 L 21 10";
                active: root.tab == 1;
                clicked => { root.selected(1); }
            }
        }
    }
}

export component AboutWindow inherits Window {
    title: @tr("About Vigie");
    icon: @image-url("../../../assets/brand/icons/vigie-256.png");
    background: Theme.background;
    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-3;
        alignment: start;
        Image {
            source: @image-url("../../../assets/brand/vigie-icon.svg");
            width: 64px;
            height: 64px;
            horizontal-alignment: center;
        }
        Text {
            text: "Vigie";
            color: Theme.text;
            font-size: Theme.font-title;
            font-weight: Theme.weight-strong;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("A fast cross-platform task manager.");
            color: Theme.text-muted;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
        AboutSlint { }
    }
}

export component AppWindow inherits Window {
    in property <[ProcRow]> rows;
    in property <[image]> icons;
    in property <string> process-count;
    // Processes matching the search, shown as "12 of 434" while searching.
    in property <string> matching-count;
    in property <string> self-cpu: "—";
    in property <string> self-memory: "—";
    in property <int> sort-column: 2;
    in property <bool> sort-ascending;
    in-out property <string> search-text;
    in-out property <ColumnSet> columns: { publisher: false, pid: true, cpu: true, memory: true };
    // The selected process. Rust keeps `selected` up to date as rows refresh, and clears
    // `has-selection` when the process leaves the table.
    in-out property <bool> has-selection;
    // Shown view: 0 processes, 1 performance.
    in-out property <int> tab;
    callback tab-changed(int);
    in property <PerfView> perf;
    in property <[float]> perf-cores;
    in property <[DiskCard]> perf-disks;
    in-out property <ProcRow> selected;
    callback show-about();
    callback sort-clicked(int);
    callback search-edited(string);
    callback toggle-clicked(int);
    // Fold or unfold a section (0 apps, 1 background, 2 system, 3 all).
    callback group-clicked(int);
    // Keyboard navigation: move the selection by this many process rows (Rust skips headers).
    callback move-selection(int);
    // Last action's outcome, shown in the status bar (see src/model.rs for the codes).
    in-out property <int> notice-kind;
    in property <string> notice-name;
    in property <int> notice-pid;
    in property <int> notice-count;
    callback request-action(int, int, int);

    // Action codes shared with src/main.rs.
    // 0 end, 1 end tree, 2 suspend, 3 resume, 4-8 priority (low to high), 9 reveal, 10 copy.
    property <bool> confirm-open;
    property <int> confirm-action;
    property <string> confirm-name;
    property <int> confirm-pid;
    property <int> confirm-start;
    property <int> confirm-count;
    property <bool> searching: root.search-text != "";

    // Destructive actions ask first and name their target; the others run at once.
    public function ask(item: ProcRow, action: int) {
        if (action == 3 || action >= 9) {
            root.request-action(item.pid, item.start, action);
            return;
        }
        root.confirm-action = action;
        root.confirm-name = item.name;
        root.confirm-pid = item.pid;
        root.confirm-start = item.start;
        root.confirm-count = item.tree-size;
        root.confirm-open = true;
    }

    public function select(item: ProcRow) {
        root.selected = item;
        root.has-selection = true;
        table.focus();
    }

    // Scrolls the table just enough to show row `index`.
    public function scroll-to(index: int) {
        let top = index * Theme.row-height;
        if (top < -list.content-y) {
            list.content-y = -top;
        } else if (top + Theme.row-height > -list.content-y + list.visible-height) {
            list.content-y = -(top + Theme.row-height - list.visible-height);
        }
    }

    function priority-name(action: int) -> string {
        return action == 4 ? @tr("Low") : action == 5 ? @tr("Below normal") : action == 6 ? @tr("Normal")
            : action == 7 ? @tr("Above normal") : @tr("High");
    }

    function notice-text() -> string {
        return root.notice-kind == 1 ? @tr("Ended {} (PID {})", root.notice-name, root.notice-pid)
            : root.notice-kind == 2 ? @tr("Ended {} (PID {}) and {} child processes", root.notice-name, root.notice-pid, root.notice-count)
            : root.notice-kind == 3 ? @tr("Suspended {} (PID {})", root.notice-name, root.notice-pid)
            : root.notice-kind == 4 ? @tr("Resumed {} (PID {})", root.notice-name, root.notice-pid)
            : root.notice-kind == 5 ? @tr("Changed the priority of {} (PID {})", root.notice-name, root.notice-pid)
            : root.notice-kind == 6 ? @tr("Copied the command line of {} (PID {})", root.notice-name, root.notice-pid)
            : root.notice-kind == 7 ? @tr("{} (PID {}) has already exited", root.notice-name, root.notice-pid)
            : root.notice-kind == 8 ? @tr("Access denied for {} (PID {}). Restart Vigie as administrator to act on it.", root.notice-name, root.notice-pid)
            : root.notice-kind == 9 ? @tr("Could not act on {} (PID {})", root.notice-name, root.notice-pid)
            : "";
    }

    function clear-search() {
        root.search-text = "";
        root.search-edited("");
        table.focus();
    }

    // A notice stays a few seconds, then the status bar shows the process count again.
    Timer {
        interval: 6s;
        running: root.notice-kind != 0;
        triggered => { root.notice-kind = 0; }
    }

    public function set-dark(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    title: "Vigie";
    icon: @image-url("../../../assets/brand/icons/vigie-256.png");
    preferred-width: 820px;
    preferred-height: 600px;
    background: Theme.background;

    // Window-wide shortcuts that no focused widget took: Ctrl+F searches, Escape clears it.
    FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                search.focus();
                return accept;
            }
            if (event.text == Key.Escape && root.searching) {
                root.clear-search();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            HorizontalLayout {
            vertical-stretch: 1;
            Rail {
                tab: root.tab;
                selected(index) => {
                    root.tab = index;
                    root.tab-changed(index);
                }
            }
            Rectangle {
            horizontal-stretch: 1;
            // The process view stays alive while hidden, so it keeps its scroll and selection.
            VerticalLayout {
            visible: root.tab == 0;
            HorizontalLayout {
                padding: Theme.space-3;
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                spacing: Theme.space-2;
                Text {
                    text: @tr("Processes");
                    color: Theme.text;
                    font-size: Theme.font-section;
                    font-weight: Theme.weight-strong;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                search := LineEdit {
                    width: 300px;
                    placeholder-text: @tr("Search name, PID or publisher (Ctrl+F)");
                    text <=> root.search-text;
                    edited(text) => { root.search-edited(text); }
                }
                // Everything else: process actions, columns, About.
                more := ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: @tr("Suspend");
                            enabled: root.has-selection && !root.selected.own;
                            activated => { root.ask(root.selected, 2); }
                        }
                        MenuItem {
                            title: @tr("Resume");
                            enabled: root.has-selection;
                            activated => { root.ask(root.selected, 3); }
                        }
                        Menu {
                            title: @tr("Priority");
                            enabled: root.has-selection;
                            MenuItem { title: root.priority-name(4); activated => { root.ask(root.selected, 4); } }
                            MenuItem { title: root.priority-name(5); activated => { root.ask(root.selected, 5); } }
                            MenuItem { title: root.priority-name(6); activated => { root.ask(root.selected, 6); } }
                            MenuItem { title: root.priority-name(7); activated => { root.ask(root.selected, 7); } }
                            MenuItem { title: root.priority-name(8); activated => { root.ask(root.selected, 8); } }
                        }
                        MenuItem {
                            title: @tr("Open file location");
                            enabled: root.has-selection;
                            activated => { root.ask(root.selected, 9); }
                        }
                        MenuItem {
                            title: @tr("Copy command line");
                            enabled: root.has-selection;
                            activated => { root.ask(root.selected, 10); }
                        }
                        MenuSeparator { }
                        Menu {
                            title: @tr("Columns");
                            MenuItem { title: @tr("Publisher"); checkable: true; checked: root.columns.publisher; activated => { root.columns.publisher = !root.columns.publisher; } }
                            MenuItem { title: @tr("PID"); checkable: true; checked: root.columns.pid; activated => { root.columns.pid = !root.columns.pid; } }
                            MenuItem { title: @tr("CPU"); checkable: true; checked: root.columns.cpu; activated => { root.columns.cpu = !root.columns.cpu; } }
                            MenuItem { title: @tr("Memory"); checkable: true; checked: root.columns.memory; activated => { root.columns.memory = !root.columns.memory; } }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("About Vigie");
                            activated => { root.show-about(); }
                        }
                    }
                    more-button := Button {
                        text: "···";
                        clicked => { more.show({ x: 0, y: self.height }); }
                    }
                }
            }

            // Command bar: acts on the selected process and names it.
            Rectangle {
                height: 44px;
                background: Theme.surface;
                Rectangle { y: 0; height: 1px; background: Theme.border; }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    padding-top: Theme.space-1;
                    padding-bottom: Theme.space-1;
                    spacing: Theme.space-2;
                    Cell {
                        // A failed action is said here, next to the buttons that started it.
                        text: root.notice-kind >= 7 ? root.notice-text()
                            : root.has-selection ? @tr("{} · PID {}", root.selected.name, root.selected.pid)
                            : @tr("Select a process to act on it");
                        color: root.notice-kind >= 7 ? Theme.danger
                            : root.has-selection ? Theme.text : Theme.text-muted;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: @tr("End process tree");
                        enabled: root.has-selection && root.selected.tree-size > 0;
                        clicked => { root.ask(root.selected, 1); }
                    }
                    Button {
                        text: @tr("End task");
                        primary: true;
                        enabled: root.has-selection;
                        clicked => { root.ask(root.selected, 0); }
                    }
                }
            }

            // Right-click the header to choose the columns (also in the ··· menu).
            ContextMenuArea {
                height: Theme.bar-height;
                Menu {
                    MenuItem { title: @tr("Publisher"); checkable: true; checked: root.columns.publisher; activated => { root.columns.publisher = !root.columns.publisher; } }
                    MenuItem { title: @tr("PID"); checkable: true; checked: root.columns.pid; activated => { root.columns.pid = !root.columns.pid; } }
                    MenuItem { title: @tr("CPU"); checkable: true; checked: root.columns.cpu; activated => { root.columns.cpu = !root.columns.cpu; } }
                    MenuItem { title: @tr("Memory"); checkable: true; checked: root.columns.memory; activated => { root.columns.memory = !root.columns.memory; } }
                }
                Columns {
                    SortHeader {
                        label: @tr("Name"); column: 0; horizontal-stretch: 1;
                        sort-column: root.sort-column; sort-ascending: root.sort-ascending;
                        clicked(c) => { root.sort-clicked(c); }
                    }
                    if root.columns.publisher: HeaderCell {
                        text: @tr("Publisher");
                        width: 160px;
                    }
                    if root.columns.pid: SortHeader {
                        label: @tr("PID"); column: 1; width: 72px; alignment: right;
                        sort-column: root.sort-column; sort-ascending: root.sort-ascending;
                        clicked(c) => { root.sort-clicked(c); }
                    }
                    if root.columns.cpu: SortHeader {
                        label: @tr("CPU"); column: 2; width: 72px; alignment: right;
                        sort-column: root.sort-column; sort-ascending: root.sort-ascending;
                        clicked(c) => { root.sort-clicked(c); }
                    }
                    if root.columns.memory: SortHeader {
                        label: @tr("Memory"); column: 3; width: 96px; alignment: right;
                        sort-column: root.sort-column; sort-ascending: root.sort-ascending;
                        clicked(c) => { root.sort-clicked(c); }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            // The table takes keyboard focus once a row is clicked.
            table := FocusScope {
                vertical-stretch: 1;
                key-pressed(event) => {
                    if (event.text == Key.DownArrow) { root.move-selection(1); return accept; }
                    if (event.text == Key.UpArrow) { root.move-selection(-1); return accept; }
                    if (event.text == Key.PageDown) { root.move-selection(10); return accept; }
                    if (event.text == Key.PageUp) { root.move-selection(-10); return accept; }
                    if (event.text == Key.End) { root.move-selection(1000000); return accept; }
                    if (event.text == Key.Home) { root.move-selection(-1000000); return accept; }
                    if (!root.has-selection) { return reject; }
                    if (event.text == Key.RightArrow && root.selected.expandable && !root.selected.expanded) {
                        root.toggle-clicked(root.selected.pid);
                        return accept;
                    }
                    if (event.text == Key.LeftArrow && root.selected.expanded) {
                        root.toggle-clicked(root.selected.pid);
                        return accept;
                    }
                    if (event.text == Key.Return && root.selected.expandable) {
                        root.toggle-clicked(root.selected.pid);
                        return accept;
                    }
                    if (event.text == Key.Delete) {
                        root.ask(root.selected, 0);
                        return accept;
                    }
                    return reject;
                }

                list := ListView {
                    for row in root.rows: Rectangle {
                        height: Theme.row-height;
                        property <bool> is-selected: root.has-selection && row.kind != 0 && row.key == root.selected.key;
                        if row.kind == 0: GroupHeader {
                            group: row.group;
                            count: row.count;
                            open: row.expanded;
                            toggle => { root.group-clicked(row.group); }
                        }
                        if row.kind != 0: ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: @tr("End task");
                                    activated => { root.ask(row, 0); }
                                }
                                MenuItem {
                                    title: @tr("End process tree");
                                    enabled: row.tree-size > 0;
                                    activated => { root.ask(row, 1); }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Suspend");
                                    enabled: !row.own;
                                    activated => { root.ask(row, 2); }
                                }
                                MenuItem {
                                    title: @tr("Resume");
                                    activated => { root.ask(row, 3); }
                                }
                                Menu {
                                    title: @tr("Priority");
                                    MenuItem { title: root.priority-name(4); activated => { root.ask(row, 4); } }
                                    MenuItem { title: root.priority-name(5); activated => { root.ask(row, 5); } }
                                    MenuItem { title: root.priority-name(6); activated => { root.ask(row, 6); } }
                                    MenuItem { title: root.priority-name(7); activated => { root.ask(row, 7); } }
                                    MenuItem { title: root.priority-name(8); activated => { root.ask(row, 8); } }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Open file location");
                                    activated => { root.ask(row, 9); }
                                }
                                MenuItem {
                                    title: @tr("Copy command line");
                                    activated => { root.ask(row, 10); }
                                }
                            }
                            // Hover and selection tints, under the content.
                            Rectangle {
                                background: is-selected ? Theme.selection
                                    : touch.has-hover ? Theme.text.with-alpha(0.05) : transparent;
                            }
                            Rectangle {
                                x: 0;
                                width: 3px;
                                background: is-selected ? Theme.accent : transparent;
                            }
                            // Click selects, double-click expands, right click selects then opens
                            // the menu. Under the line, so the chevron keeps its own clicks.
                            touch := TouchArea {
                                clicked => { root.select(row); }
                                double-clicked => {
                                    if (row.expandable) { root.toggle-clicked(row.pid); }
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                        root.select(row);
                                    }
                                }
                            }
                            ProcessLine {
                                item: row;
                                icon: root.icons[row.icon];
                                columns: root.columns;
                                toggle(pid) => { root.toggle-clicked(pid); }
                            }
                        }
                    }
                }

                // Nothing matches the search: say so and offer the way back.
                if root.searching && root.rows.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-3;
                    Text {
                        text: @tr("No process matches “{}”", root.search-text);
                        color: Theme.text-muted;
                        font-size: Theme.font-section;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Button {
                            text: @tr("Clear search");
                            clicked => { root.clear-search(); }
                        }
                    }
                }
            }
            }

            if root.tab == 1: PerformanceView {
                view: root.perf;
                cores: root.perf-cores;
                disks: root.perf-disks;
            }
            }
            }

            Rectangle {
                height: Theme.bar-height;
                background: Theme.surface;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }
                Columns {
                    spacing: Theme.space-4;
                    // The lagoon dot marks what is live: Vigie reporting on itself.
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: Theme.space-2;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: Theme.lagoon;
                        }
                        Cell {
                            text: @tr("Vigie {} CPU · {}", root.self-cpu, root.self-memory);
                            font-size: Theme.font-caption;
                        }
                    }
                    Cell {
                        text: root.notice-kind != 0 && root.notice-kind < 7 ? root.notice-text()
                            : root.searching ? @tr("{} of {} processes", root.matching-count, root.process-count)
                            : @tr("{} processes", root.process-count);
                        color: Theme.text-muted;
                        font-size: Theme.font-caption;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }

    // Confirmation for destructive actions: names the process, its PID and what will happen.
    if root.confirm-open: Rectangle {
        background: #000000.with-alpha(0.45);
        // Swallow clicks outside the dialog; Escape or Cancel closes it.
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.confirm-open = false;
                    return accept;
                }
                return reject;
            }
            init => { self.focus(); }
        }
        Rectangle {
            width: 420px;
            height: dialog.preferred-height;
            background: Theme.raised;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.border;
            dialog := VerticalLayout {
                padding: Theme.space-6;
                spacing: Theme.space-3;
                Text {
                    text: root.confirm-action == 0 ? @tr("End {} (PID {})?", root.confirm-name, root.confirm-pid)
                        : root.confirm-action == 1 ? @tr("End {} (PID {}) and its {} child processes?", root.confirm-name, root.confirm-pid, root.confirm-count)
                        : root.confirm-action == 2 ? @tr("Suspend {} (PID {})?", root.confirm-name, root.confirm-pid)
                        : @tr("Set the priority of {} (PID {}) to {}?", root.confirm-name, root.confirm-pid, root.priority-name(root.confirm-action));
                    color: Theme.text;
                    font-size: Theme.font-section;
                    font-weight: Theme.weight-strong;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-action == 0 ? @tr("Unsaved work in this program will be lost.")
                        : root.confirm-action == 1 ? @tr("Unsaved work in these programs will be lost.")
                        : root.confirm-action == 2 ? @tr("It stops running until you resume it. Suspending a system process can freeze Windows.")
                        : @tr("A high priority can slow down the rest of the system.");
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-2;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.confirm-open = false; }
                    }
                    Button {
                        primary: true;
                        text: root.confirm-action == 0 ? @tr("End task")
                            : root.confirm-action == 1 ? @tr("End process tree")
                            : root.confirm-action == 2 ? @tr("Suspend")
                            : @tr("Change priority");
                        clicked => {
                            root.confirm-open = false;
                            root.request-action(root.confirm-pid, root.confirm-start, root.confirm-action);
                        }
                    }
                }
            }
        }
    }
}
