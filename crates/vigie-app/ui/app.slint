import { AboutSlint, Button, LineEdit, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct ProcRow {
    name: string,
    pid: int,
    cpu: string,
    memory: string,
}

component Cell inherits Text {
    vertical-alignment: center;
    overflow: elide;
    color: Theme.text;
    font-size: Theme.font-body;
}

component HeaderCell inherits Cell {
    color: Theme.text-muted;
    font-size: Theme.font-caption;
    font-weight: Theme.weight-strong;
}

component Columns inherits HorizontalLayout {
    padding-left: Theme.space-4;
    padding-right: Theme.space-4;
    spacing: Theme.space-3;
}

// A clickable column header. The active column shows its direction.
component SortHeader inherits Rectangle {
    in property <string> label;
    in property <int> column;
    in property <int> sort-column;
    in property <bool> sort-ascending;
    in property <TextHorizontalAlignment> alignment: left;
    callback clicked(int);
    property <bool> active: column == sort-column;

    HeaderCell {
        width: 100%;
        height: 100%;
        horizontal-alignment: root.alignment;
        text: root.active ? (root.sort-ascending ? root.label + " ↑" : root.label + " ↓") : root.label;
        color: root.active || touch.has-hover ? Theme.text : Theme.text-muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.column); }
    }
}

export component AboutWindow inherits Window {
    title: @tr("About Vigie");
    icon: @image-url("../../../assets/brand/icons/vigie-256.png");
    background: Theme.background;
    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-3;
        alignment: start;
        Image {
            source: @image-url("../../../assets/brand/vigie-icon.svg");
            width: 64px;
            height: 64px;
            horizontal-alignment: center;
        }
        Text {
            text: "Vigie";
            color: Theme.text;
            font-size: Theme.font-title;
            font-weight: Theme.weight-strong;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("A fast cross-platform task manager.");
            color: Theme.text-muted;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
        AboutSlint { }
    }
}

export component AppWindow inherits Window {
    in property <[ProcRow]> rows;
    in property <string> process-count;
    in property <string> self-cpu: "—";
    in property <string> self-memory: "—";
    in property <int> sort-column: 2;
    in property <bool> sort-ascending;
    in-out property <string> search-text;
    callback show-about();
    callback sort-clicked(int);
    callback search-edited(string);

    public function set-dark(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    title: "Vigie";
    icon: @image-url("../../../assets/brand/icons/vigie-256.png");
    preferred-width: 760px;
    preferred-height: 560px;
    background: Theme.background;

    VerticalLayout {
        HorizontalLayout {
            padding: Theme.space-3;
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;
            spacing: Theme.space-3;
            Text {
                text: @tr("Processes");
                color: Theme.text;
                font-size: Theme.font-section;
                font-weight: Theme.weight-strong;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            LineEdit {
                width: 260px;
                placeholder-text: @tr("Search name or PID");
                text <=> root.search-text;
                edited(text) => { root.search-edited(text); }
            }
        }

        Rectangle {
            height: Theme.bar-height;
            Columns {
                SortHeader {
                    label: @tr("Name"); column: 0; horizontal-stretch: 1;
                    sort-column: root.sort-column; sort-ascending: root.sort-ascending;
                    clicked(c) => { root.sort-clicked(c); }
                }
                SortHeader {
                    label: @tr("PID"); column: 1; width: 72px; alignment: right;
                    sort-column: root.sort-column; sort-ascending: root.sort-ascending;
                    clicked(c) => { root.sort-clicked(c); }
                }
                SortHeader {
                    label: @tr("CPU"); column: 2; width: 72px; alignment: right;
                    sort-column: root.sort-column; sort-ascending: root.sort-ascending;
                    clicked(c) => { root.sort-clicked(c); }
                }
                SortHeader {
                    label: @tr("Memory"); column: 3; width: 96px; alignment: right;
                    sort-column: root.sort-column; sort-ascending: root.sort-ascending;
                    clicked(c) => { root.sort-clicked(c); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        ListView {
            vertical-stretch: 1;
            for row in root.rows: Rectangle {
                height: Theme.row-height;
                Columns {
                    Cell { text: row.name; horizontal-stretch: 1; }
                    Cell { text: row.pid; width: 72px; horizontal-alignment: right; color: Theme.text-muted; }
                    Cell { text: row.cpu; width: 72px; horizontal-alignment: right; }
                    Cell { text: row.memory; width: 96px; horizontal-alignment: right; }
                }
            }
        }

        Rectangle {
            height: Theme.bar-height + 6px;
            background: Theme.surface;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }
            Columns {
                spacing: Theme.space-4;
                // The lagoon dot marks what is live: Vigie reporting on itself.
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: Theme.space-2;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: Theme.lagoon;
                    }
                    Cell {
                        text: @tr("Vigie {} CPU · {}", root.self-cpu, root.self-memory);
                        font-size: Theme.font-caption;
                    }
                }
                Cell {
                    text: @tr("{} processes", root.process-count);
                    color: Theme.text-muted;
                    font-size: Theme.font-caption;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("About");
                    clicked => { root.show-about(); }
                }
            }
        }
    }
}
